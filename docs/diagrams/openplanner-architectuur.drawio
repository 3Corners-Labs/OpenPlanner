<mxfile host="drawio" agent="OpenPlanner scripts/diagrams"><diagram id="p1" name="1 Hoofdlijn"><mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1-1" value="OpenPlanner · Hoofdlijn: bouwblokken en omgeving" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#154273;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="34" as="geometry"/></mxCell><mxCell id="p1-2" value="Zeventien bouwblokken in vier families. Links wie de dienst gebruikt, rechts de systemen waar OpenPlanner mee praat. Burgers loggen nooit in; alleen beheerders via de identity provider. Persoonsgegevens staan alleen op Booking. Stand 27 oktober 2026." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#5a6577;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1520" height="40" as="geometry"/></mxCell><mxCell id="p1-3" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;strokeColor=#0f7a6e;fillColor=#e3f3f0;strokeWidth=1.5;fontColor=#142033;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="16" height="16" as="geometry"/></mxCell><mxCell id="p1-4" value="Burgerkanaal" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5a6577;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="62" y="99" width="100" height="20" as="geometry"/></mxCell><mxCell id="p1-5" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;strokeColor=#154273;fillColor=#e4ecf5;strokeWidth=1.5;fontColor=#142033;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry 