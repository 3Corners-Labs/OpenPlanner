# TLS termination for OpenPlanner (ADR 0030). Caddy obtains the certificate for TLS_DOMAIN
# from a public ACME CA (Let's Encrypt by default), renews it on its own when a third of its
# lifetime is left, and staples OCSP. Certificates and the ACME account live in /data.
# With an own certificate (ADR 0064) entrypoint.sh sets TLS_DIRECTIVE to `tls <cert> <key>`,
# which turns Caddy's certificate management off for the site; the mailbox is then unused.
{
	email {$ACME_EMAIL:nobody@openplanner.invalid}
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
	# Unprivileged ports inside the container; docker-compose publishes them as 80 and 443.
	http_port 8080
	https_port 8443
	# Caddy's own redirect would point at :8443; the site below redirects to 443 instead.
	# ACME HTTP-01 challenges on port 80 are still answered.
	auto_https disable_redirects
	admin 127.0.0.1:2019
	servers {
		protocols h1 h2
		# Caddy sets no read timeouts by default; these stop slow-loris clients. No page
		# streams, so a write timeout is safe.
		timeouts {
			read_header 10s
			read_body 30s
			write 60s
			idle 2m
		}
		# The reverse proxies, WAFs and load balancers in front of this one (PROXY_TRUSTED_NETWORKS,
		# ADR 0129): from them the visitor's address is read out of X-Forwarded-For, right to left.
		# entrypoint.sh renders the directive; empty, nobody is trusted and the peer is the visitor.
		{$TRUSTED_PROXIES_DIRECTIVE}
	}
}

http://{$TLS_DOMAIN}:8080 {
	# Machine clients (bots, Webex Connect, WxCC) send secrets and bodies. A 308 would make
	# a client that was configured with http:// repeat the POST in clear and succeed without
	# anyone noticing, so these paths are refused outright, without a Location header (ASVS
	# V4.1.2). Browser paths keep their redirect. ACME HTTP-01 challenges are answered by
	# Caddy before this block is reached.
	@machine path /api/* /webhooks/*
	handle @machine {
		respond "HTTPS required" 403
	}
	handle {
		redir https://{host}{uri} 308
	}
}

{$TLS_DOMAIN}:8443 {
	{$TLS_DIRECTIVE}
	# No access log: request paths carry management tokens (/b/{token}).
	# Public form posts are small; the limit keeps oversized bodies away from the app.
	@public path /g/* /b/*
	request_body @public {
		max_size 64KB
	}
	# A configuration package (ADR 0089) is larger than any form. The portal import and the agent
	# API import get the ceiling of configuration_package_max_mb (512 MiB) here; the app enforces
	# the configured limit. Caddy applies every matching limit, so @other must list all paths.
	@package path /admin/settings/package/import /api/agent/v1/configuration
	request_body @package {
		max_size 512MiB
	}
	@other not path /g/* /b/* /admin/settings/package/import /api/agent/v1/configuration
	request_body @other {
		max_size 1MB
	}
	# Every upstream gets exactly one address in X-Forwarded-For: the visitor's ({client_ip}).
	# Without trusted networks that is the peer, and any value the client sent is dropped; from a
	# trusted edge it is the first untrusted address, right to left (ADR 0129). Rate limits,
	# pseudonyms and webhook source networks in the app therefore see the real visitor.
	# The bundled identity provider (ADR 0112) is served under /idp when IDP_UPSTREAM is set;
	# entrypoint.sh renders IDP_DIRECTIVE, empty otherwise.
	{$IDP_DIRECTIVE}
	# Everything else goes to web at its fixed address on edge (WEB_UPSTREAM, docker-compose.yml),
	# never to a name this host's DNS could answer while web is down (ADR 0125 step 2).
	handle {
		reverse_proxy {$WEB_UPSTREAM} {
			header_up X-Forwarded-For {client_ip}
		}
	}
}
