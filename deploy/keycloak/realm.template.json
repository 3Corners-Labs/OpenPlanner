{
  "realm": "openplanner",
  "enabled": true,
  "displayName": "OpenPlanner",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"unmanagedAttributePolicy\": \"ADMIN_EDIT\", \"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\"}]}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "openplanner-admin",
      "name": "OpenPlanner admin portal",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_OPENPLANNER_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${KC_OPENPLANNER_BASE_URL}/admin/callback"
      ],
      "webOrigins": [
        "${KC_OPENPLANNER_BASE_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${KC_OPENPLANNER_BASE_URL}/admin/logged-out"
      },
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "roles",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "aggregate.attrs": "false"
          }
        },
        {
          "name": "organisations",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "organisations",
            "claim.name": "organisations",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "aggregate.attrs": "false"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "groups",
            "claim.name": "groups",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "aggregate.attrs": "false"
          }
        },
        {
          "name": "openplanner_entitlements",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "entitlements",
            "claim.name": "openplanner_entitlements",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "aggregate.attrs": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "super",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Sanne",
      "lastName": "Super",
      "email": "super@openplanner.invalid",
      "attributes": {
        "roles": [
          "openplanner-superuser",
          "openplanner-org-admin",
          "openplanner-group-admin",
          "openplanner-auditor",
          "openplanner-agent"
        ],
        "organisations": [
          "demo"
        ],
        "groups": [
          "demo"
        ],
        "entitlements": [
          "openplanner:superuser"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "${KC_SUPER_PASSWORD}",
          "temporary": true
        }
      ],
      "requiredActions": [
        "UPDATE_PASSWORD"
      ]
    }
  ]
}
