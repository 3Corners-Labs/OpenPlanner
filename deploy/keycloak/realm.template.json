{
  "realm": "openplanner",
  "enabled": true,
  "displayName": "OpenPlanner",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"unmanagedAttributePolicy\": \"ADMIN_EDIT\", \"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\"}]}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "openplanner-admin",
      "name": "OpenPlanner admin portal",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_OPENPLANNER_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${KC_OPENPLANNER_BASE_URL}/admin/callback"
      ],
      "webOrigins": [
        "${KC_OPENPLANNER_BASE_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${KC_OPENPLANNER_BASE_URL}/admin/logged-out",
        "acr.loa.map": "{\"mfa\":2}",
        "default.acr.values": "mfa"
      },
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "roles",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "aggregate.attrs": "false"
          }
        },
        {
          "name": "organisations",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "organisations",
            "claim.name": "organisations",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "aggregate.attrs": "false"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "groups",
            "claim.name": "groups",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "aggregate.attrs": "false"
          }
        },
        {
          "name": "openplanner_entitlements",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "entitlements",
            "claim.name": "openplanner_entitlements",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "aggregate.attrs": "false"
          }
        }
      ]
    },
    {
      "clientId": "openplanner-directory",
      "name": "OpenPlanner staff management (ADR 0095)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_DIRECTORY_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "super",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Sanne",
      "lastName": "Super",
      "email": "super@openplanner.invalid",
      "attributes": {
        "roles": [
          "openplanner-superuser",
          "openplanner-org-admin",
          "openplanner-group-admin",
          "openplanner-auditor",
          "openplanner-agent"
        ],
        "organisations": [
          "demo"
        ],
        "groups": [
          "demo"
        ],
        "entitlements": [
          "openplanner:superuser"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "${KC_SUPER_PASSWORD}",
          "temporary": true
        }
      ],
      "requiredActions": [
        "UPDATE_PASSWORD",
        "CONFIGURE_TOTP"
      ]
    },
    {
      "username": "service-account-openplanner-directory",
      "enabled": true,
      "serviceAccountClientId": "openplanner-directory",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-realm"
        ]
      }
    }
  ],
  "browserFlow": "openplanner browser",
  "otpPolicyType": "totp",
  "webAuthnPolicyUserVerificationRequirement": "required",
  "authenticationFlows": [
    {
      "alias": "openplanner browser",
      "description": "Cookie, or password and a second factor (ADR 0100)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "openplanner browser forms",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "openplanner browser forms",
      "description": "Password, then the second factor when level 2 (mfa) is asked",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "openplanner second factor",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "openplanner second factor",
      "description": "Only when the client asks for acr mfa (level 2)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorConfig": "openplanner level 2"
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": true
        },
        {
          "authenticator": "webauthn-authenticator",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": true
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "openplanner level 2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "36000"
      }
    }
  ],
  "resetPasswordAllowed": true
}
