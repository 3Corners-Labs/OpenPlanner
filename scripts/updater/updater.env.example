# /etc/openplanner/updater.env: configuration of the host updater (ADR 0028). Mode 600, root.
# Directory with docker-compose.yml, .env and .env.update (the pinned image).
COMPOSE_DIR=/opt/openplanner
# The repository's image; releases are pulled as <UPDATE_IMAGE>:<version>.
UPDATE_IMAGE=ghcr.io/<owner>/<repo>
# Only images signed by this repository's main workflow for a release tag are installed.
CERT_IDENTITY_REGEXP=^https://github\.com/<owner>/<repo>/\.github/workflows/main\.yml@refs/tags/v[0-9]+\.[0-9]+\.[0-9]+$
# Seconds a new version may take to become healthy before it is rolled back.
HEALTH_TIMEOUT=300
READY_URL=http://127.0.0.1:8000/readyz
