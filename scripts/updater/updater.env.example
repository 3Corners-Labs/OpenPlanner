# /etc/openplanner/updater.env: configuration of the host updater (ADR 0029). Mode 600, root.
# The checkout with docker-compose.yml, .env and .env.update (the pinned image). scripts/install.sh
# writes this file; edit it only when installing by hand (docs/install.md).
COMPOSE_DIR=/home/<user>/openplanner
# The repository's image; releases are pulled as <UPDATE_IMAGE>:<version>.
UPDATE_IMAGE=ghcr.io/<owner>/<repo>
# Only images signed by this repository's main workflow for a release tag are installed.
# Single quotes: the updater sources this file, and unquoted bash drops the backslashes, so
# every `\.` would match any character.
CERT_IDENTITY_REGEXP='^https://github\.com/<owner>/<repo>/\.github/workflows/main\.yml@refs/tags/v[0-9]+\.[0-9]+\.[0-9]+$'
# Seconds a new version may take to become healthy before it is rolled back.
HEALTH_TIMEOUT=300
READY_URL=http://127.0.0.1:8000/readyz
