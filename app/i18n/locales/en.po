msgstr "Skip to content"

msgid "home.title"
msgstr "Schedule a video call"

msgid "home.intro"
msgstr "The website of your organisation links you to the booking page of the right team. There you choose a time for a video call with an employee."

msgid "home.how.title"
msgstr "How it works"

msgid "home.how.step_choose"
msgstr "Choose a day and time that suits you."

msgid "home.how.step_details"
msgstr "Enter your name and email address."

msgid "home.how.step_confirm"
msgstr "You receive a confirmation with the link to the video call. You can also use that email to change or cancel the appointment."

msgid "home.privacy"
msgstr "We keep your details until 24 hours after the call. Then we delete them."

#. Messages (email). Placeholders: {first_name}, {date}, {time}, {group_name}, {deadline}.
msgid "message.greeting"
msgstr "Dear {first_name},"

msgid "message.when"
msgstr "When"

msgid "message.team"
msgstr "Team"

msgid "message.manage"
msgstr "You can view, change or cancel the appointment until {deadline}. After that the appointment is fixed."

msgid "message.manage_link"
msgstr "View or change appointment"

msgid "message.signoff"
msgstr "Kind regards, {group_name}"

msgid "message.calendar_summary"
msgstr "Video call with {group_name}"

msgid "message.confirmation.subject"
msgstr "Confirmation of your video call on {date}"

