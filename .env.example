# Copy to .env for local overrides. Never commit real values; production secrets
# come from the secret store, not from a file.
ENVIRONMENT=dev
DATABASE_URL=sqlite+aiosqlite:///data/booking.db
LOG_LEVEL=INFO
WORKER_POLL_SECONDS=10

# Base URL used in links inside messages.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ADR 0011. Required in production (at least 32 bytes, from the secret store).
# In development a shared key is generated in the data volume when this is empty.
# MANAGEMENT_TOKEN_KEY=<generate: python -c "import secrets; print(secrets.token_urlsafe(48))">

# Outgoing mail. With `docker compose --profile dev up` Mailpit catches everything.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
MAIL_FROM=OpenPlanner demo <noreply@openplanner.invalid>

# Admin portal (ADR 0013). Production: PingFederate discovery URL (https) and its client
# secret from the secret store. With `--profile dev`, the local Keycloak below.
OIDC_DISCOVERY_URL=http://keycloak:8080/realms/openplanner/.well-known/openid-configuration
OIDC_CLIENT_ID=openplanner-admin
OIDC_CLIENT_SECRET=dev-only-openplanner-admin-secret
# SESSION_SECRET=<generate: python -c "import secrets; print(secrets.token_urlsafe(48))">
