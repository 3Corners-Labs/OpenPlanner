# Copy to .env for local overrides. Never commit real values; production secrets
# come from the secret store, not from a file.
ENVIRONMENT=dev
DATABASE_URL=sqlite+aiosqlite:///data/booking.db
LOG_LEVEL=INFO
# Clock times: 24h (default), 12h or locale (Dutch 15:05, English 3:05 PM).
TIME_FORMAT=24h
WORKER_POLL_SECONDS=10

# Base URL used in links inside messages.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Optional: where Webex and WxCC deliver webhooks (https, public domain, port 443), e.g. a
# tunnel to this machine. The OIDC redirect and the links in messages stay on PUBLIC_BASE_URL.
# Must be https in production. Empty: webhooks use PUBLIC_BASE_URL.
# WEBHOOK_BASE_URL=https://<your-tunnel>.trycloudflare.com

# ADR 0011. Required in production (at least 32 bytes, from the secret store).
# In development a shared key is generated in the data volume when this is empty.
# MANAGEMENT_TOKEN_KEY=<generate: python -c "import secrets; print(secrets.token_urlsafe(48))">

# Outgoing mail: the fallback for organisations without their own SMTP server in the admin
# portal (ADR 0022). With `docker compose --profile dev up` Mailpit catches everything.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
MAIL_FROM=OpenPlanner demo <noreply@openplanner.invalid>

# Admin portal (ADR 0013). Production: PingFederate discovery URL (https) and its client
# secret from the secret store. With `--profile dev`, the local Keycloak below.
OIDC_DISCOVERY_URL=http://keycloak:8080/realms/openplanner/.well-known/openid-configuration
OIDC_CLIENT_ID=openplanner-admin
OIDC_CLIENT_SECRET=dev-only-openplanner-admin-secret
# SESSION_SECRET=<generate: python -c "import secrets; print(secrets.token_urlsafe(48))">

# Webex Service App (ADR 0017/0018): one app for meetings and WxCC work items. Leave empty to
# run without video and WxCC. Values come from the developer portal after a Control Hub admin
# authorised the app; never commit them. Rotated tokens are stored encrypted in the database.
# WEBEX_CLIENT_ID=
# WEBEX_CLIENT_SECRET=
# WEBEX_REFRESH_TOKEN=
# WEBEX_WEBHOOK_SECRET=<generate: python -c "import secrets; print(secrets.token_urlsafe(32))">
# WxCC API host of your region, e.g. https://api.wxcc-eu1.cisco.com
# WXCC_API_BASE_URL=
# WXCC_WEBHOOK_SECRET=<generate: python -c "import secrets; print(secrets.token_urlsafe(32))">
# ADR 0008: key for integration secrets at rest (Webex tokens, SMTP passwords and SMS service
# keys of the admin portal). Required in production with WEBEX_CLIENT_ID or channel secrets.
# SETTINGS_ENCRYPTION_KEY=<generate: python -c "import secrets; print(secrets.token_urlsafe(48))">
