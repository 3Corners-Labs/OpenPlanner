# Copy to .env for local overrides. Never commit real values; production secrets
# come from the secret store, not from a file. Every setting, its class and its bounds:
# docs/settings.md (ADR 0042).
#
# First install: `docker compose run --rm web python -m app.cli init` writes the three keys
# (SETTINGS_ENCRYPTION_KEY, MANAGEMENT_TOKEN_KEY, SESSION_SECRET) to secrets/secrets.env,
# which docker-compose.yml reads next to this file. Keep a copy apart from the database backup.
# Each of those keys and OIDC_CLIENT_SECRET may instead come from a file: X_FILE=/run/secrets/x
# (Docker or Kubernetes secrets). Setting both X and X_FILE is refused.
ENVIRONMENT=dev
# Simulator for Webex/WxCC events on admin booking pages (dev/test only; refused in prod).
SIMULATOR_ENABLED=false
DATABASE_URL=sqlite+aiosqlite:///data/booking.db
LOG_LEVEL=INFO
# Clock times: 24h (default), 12h or locale (Dutch 15:05, English 3:05 PM).
TIME_FORMAT=24h
WORKER_POLL_SECONDS=10
# Days to keep system events (job outcomes) in the audit log; admin actions are kept.
SYSTEM_EVENT_RETENTION_DAYS=90
# Storage grades of the data volume (ADR 0040): below these free-space percentages the worker
# records a system event and logs every hour, and /readyz answers "degraded". DATABASE_MAX_MB
# also counts as low when the database grows past it; unset means no limit.
STORAGE_LOW_FREE_PERCENT=15
STORAGE_CRITICAL_FREE_PERCENT=5
# DATABASE_MAX_MB=2048
# Name of this installation in every log line and event record (ADR 0040), so a log platform
# that receives several can tell them apart: letters, digits, '.', '_', '-'; at most 64.
INSTALLATION_NAME=dev
# ADR 0034: rejected webhooks and failing Webex token refreshes become at most one security
# event per kind per this many minutes (1-1440); the rest are counted into the next one.
SECURITY_EVENT_WINDOW_MINUTES=15
# ADR 0040: one CSV export of the audit log holds at most this many rows and days; a larger
# one is refused, never cut short.
AUDIT_EXPORT_MAX_ROWS=100000
AUDIT_EXPORT_MAX_DAYS=366
# ADR 0040: retention per category of audit event (days) and how long diagnostic mode lasts.
AUDIT_RETENTION_DAYS=730
SECURITY_EVENT_RETENTION_DAYS=365
DIAGNOSTIC_EVENT_RETENTION_DAYS=7
DIAGNOSTIC_MODE_HOURS=24
# Days ahead the shortfall notice on group pages and the dashboard looks (ADR 0044, 1-60).
SHORTFALL_HORIZON_DAYS=14
# Changes by one planner per hour above which a system event warns; never blocks (5-1000).
PLANNER_CHANGES_ALERT_PER_HOUR=50
# A planner's request to choose a new time lapses this many days after the original start
# (1-30), with one reminder this many days before (1-29, below the first).
PLANNER_REBOOK_DAYS=14
PLANNER_REBOOK_REMINDER_DAYS=3

# Base URL used in links inside messages.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# With the bundled HTTPS proxy (ADR 0030, settings in proxy.env): https://<TLS_DOMAIN>.
# Behind a proxy of your own, also set FORWARDED_ALLOW_IPS=<its address> (default: the bundled
# proxy's fixed address 172.31.240.2).

# Optional: where Webex and WxCC deliver webhooks (https, public domain, port 443), e.g. a
# tunnel to this machine. The OIDC redirect and the links in messages stay on PUBLIC_BASE_URL.
# Must be https in production. Empty: webhooks use PUBLIC_BASE_URL.
# WEBHOOK_BASE_URL=https://<your-tunnel>.trycloudflare.com

# ADR 0011. Required in production (at least 32 bytes, from the secret store).
# In development a shared key is generated in the data volume when this is empty.
# MANAGEMENT_TOKEN_KEY=<generated by `python -m app.cli init`>

# Outgoing mail: the fallback for organisations without their own SMTP server in the admin
# portal (ADR 0022). With `docker compose --profile dev up` Mailpit catches everything.
# A real provider: SMTP_PORT=587 with SMTP_STARTTLS=true, or 465 (implicit TLS, or set
# SMTP_TLS=true on another port). A login needs one of the two; the password belongs in the
# secret store. SMTP_USER / SMTP_USER_PASSWORD are accepted as aliases.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
# SMTP_TLS=false
# SMTP_USERNAME=<mailbox login>
# SMTP_PASSWORD=<from the secret store>
MAIL_FROM=OpenPlanner demo <noreply@openplanner.invalid>

# Admin portal (ADR 0013). Production: PingFederate discovery URL (https) and its client
# secret from the secret store. With `--profile dev`, the local Keycloak below.
OIDC_DISCOVERY_URL=http://keycloak:8080/realms/openplanner/.well-known/openid-configuration
OIDC_CLIENT_ID=openplanner-admin
OIDC_CLIENT_SECRET=dev-only-openplanner-admin-secret
# OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
# OIDC_SCOPES=openid profile email
# SESSION_SECRET=<generated by `python -m app.cli init`>

# Webex Service App (ADR 0017/0018): one app for meetings and WxCC work items. Leave empty to
# run without video and WxCC. Values come from the developer portal after a Control Hub admin
# authorised the app; never commit them. Rotated tokens are stored encrypted in the database.
# WEBEX_CLIENT_ID=
# WEBEX_CLIENT_SECRET=
# WEBEX_REFRESH_TOKEN=
# WEBEX_WEBHOOK_SECRET=<generate: python -c "import secrets; print(secrets.token_urlsafe(32))">
# WxCC API host of your region, e.g. https://api.wxcc-eu1.cisco.com
# WXCC_API_BASE_URL=
# WXCC_WEBHOOK_SECRET=<generate: python -c "import secrets; print(secrets.token_urlsafe(32))">
# ADR 0008: key for integration secrets at rest (Webex tokens, SMTP passwords and SMS API
# keys of the admin portal). Required in production with WEBEX_CLIENT_ID or channel secrets.
# SETTINGS_ENCRYPTION_KEY=<generated by `python -m app.cli init`>

# Machine API for contact-center bots (ADR 0023). Off by default: the routes do not exist.
# When on, the superuser still switches it on in the admin portal (API clients) and registers
# each bot there; client secrets are created and shown there, never put in this file.
# AGENT_API_ENABLED=false
# RATE_LIMIT_AGENT_TOKENS=10/minute
# RATE_LIMIT_AGENT_CALLS=120/minute

# Updates from the admin portal (ADR 0029). With UPDATE_REPOSITORY the worker looks up the
# latest GitHub release hourly and superusers see a banner; the host updater
# (scripts/updater, docs/runbook.md) installs what they request. APP_VERSION is baked into
# release images; do not set it here.
# UPDATE_REPOSITORY=<owner>/<repo>
# Only for a private repository: a fine-grained token with read access to contents.
# UPDATE_CHECK_TOKEN=<token>

# Maintenance mode (ADR 0038; docs/runbook.md, Onderhoudsmodus). Normally switched in the admin
# portal (/admin/maintenance) or with `python -m app.cli maintenance on|off`. Set this only for
# work while the database is unavailable or being restored: the portal cannot switch it off.
# MAINTENANCE_MODE=false
# How long the web process trusts its last read of the switch (0-5 seconds).
# MAINTENANCE_CACHE_SECONDS=5
# Retry-After of the citizen pages and machine-API writes refused during maintenance (30-3600 s).
# MAINTENANCE_RETRY_AFTER_SECONDS=300

# Deployment details (class B, ADR 0042); the defaults suit docker-compose.yml.
# Off switch for every rate limit; never in the portal. Only for load tests.
# RATE_LIMIT_ENABLED=true
# Webex API endpoint; changed only for test doubles.
# WEBEX_API_BASE_URL=https://webexapis.com/v1
# Heartbeat file of the worker and the age at which its container healthcheck fails.
# WORKER_HEARTBEAT_PATH=data/worker.heartbeat
# WORKER_HEARTBEAT_MAX_AGE_SECONDS=120
# Development only: where the generated keys live when the variables above are empty.
# DEV_TOKEN_KEY_PATH=data/dev-token.key
# DEV_SESSION_KEY_PATH=data/dev-session.key
# DEV_SETTINGS_KEY_PATH=data/dev-settings.key
